<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Memory Ones</title>

  <!-- A-Frame -->
  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>

  <!-- MindAR -->
  <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    #soundButton {
      position: fixed;
      z-index: 99999;
      left: 50%;
      bottom: 30px;
      transform: translateX(-50%);

      padding: 15px 25px;
      border: none;
      border-radius: 30px;

      background: black;
      color: white;

      font-size: 18px;
      font-weight: bold;

      display: none;
    }
  </style>
</head>

<body>

  <!-- Sound Button -->
  <button id="soundButton">
    🔊 PLAY WITH SOUND
  </button>


  <a-scene
    mindar-image="imageTargetSrc: ./targets.mind;"
    color-space="sRGB"
    renderer="colorManagement: true"
    vr-mode-ui="enabled: false"
    device-orientation-permission-ui="enabled: false">


    <!-- Video -->
    <a-assets>

      <video
        id="myVideo"
        src="./birthday.mp4"
        preload="auto"
        loop
        muted
        playsinline
        webkit-playsinline>
      </video>

    </a-assets>


    <!-- Camera -->
    <a-camera
      position="0 0 0"
      look-controls="enabled: false">
    </a-camera>


    <!-- Image Target -->
    <a-entity
      id="target"
      mindar-image-target="targetIndex: 0">


      <!-- PORTRAIT VIDEO -->
      <a-video
        id="arVideo"
        width="0.5625"
        height="1"
        position="0 0 0"
        rotation="0 0 0">
      </a-video>


    </a-entity>

  </a-scene>


  <script>

    const target = document.querySelector("#target");

    const video = document.querySelector("#myVideo");

    const arVideo = document.querySelector("#arVideo");

    const soundButton = document.querySelector("#soundButton");


    // Connect video to AR
    arVideo.setAttribute("src", "#myVideo");


    // When photo is detected
    target.addEventListener("targetFound", function () {

      console.log("TARGET FOUND");

      video.currentTime = 0;

      video.muted = true;


      video.play()
        .then(function () {

          console.log("VIDEO PLAYING");

        })
        .catch(function (error) {

          console.log("VIDEO ERROR:", error);

        });


      // Show sound button
      soundButton.style.display = "block";

    });


    // Sound button
    soundButton.addEventListener("click", function () {

      console.log("SOUND BUTTON CLICKED");

      video.muted = false;

      video.volume = 1.0;


      video.play()
        .then(function () {

          console.log("VIDEO + SOUND PLAYING");

          soundButton.style.display = "none";

        })
        .catch(function (error) {

          console.log("AUDIO ERROR:", error);

        });

    });


    // When photo is no longer detected
    target.addEventListener("targetLost", function () {

      console.log("TARGET LOST");

      video.pause();

      soundButton.style.display = "none";

    });

  </script>

</body>
</html>
